{
  "name": "@alembic/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Container worker tier: site builds and Pages publication behind a job queue. v0.1 runs build jobs in-process during local dev.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alembic/generators": "workspace:*",
    "@alembic/github-bridge": "workspace:*",
    "@alembic/notify": "workspace:*",
    "@alembic/package-contract": "workspace:*",
    "@alembic/package-ops": "workspace:*",
    "@alembic/renderer": "workspace:*",
    "orz-markdown": "2.5.0",
    "orz-mdhtml": "1.1.0",
    "orz-paged": "1.1.0",
    "orz-site": "0.1.0",
    "orz-slides": "1.1.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
